# Application
NODE_ENV=development
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Bangkok
APP_LOCALE=th-TH

# MapLibre style JSON (no token required for the included demo style)
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# MariaDB 5.5 compatibility / MariaDB 11 / MySQL 8 connection string.
# URL-encode special characters in username/password (for example @ -> %40).
DATABASE_URL=mysql://digitaltwin:change-me@127.0.0.1:3306/digitaltwin
DATABASE_CHARSET=utf8mb4
DATABASE_COLLATION=utf8mb4_unicode_ci
DATABASE_CONNECTION_LIMIT=10
DATABASE_CONNECT_TIMEOUT=10000

# Login rate limiting is process-local; no Redis is required.
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60

# Authentication secrets: use long random values outside development.
AUTH_ACCESS_SECRET=replace-with-a-long-random-access-secret
AUTH_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Seed credentials. Never commit real passwords.
SEED_SUPER_ADMIN_PASSWORD=change-this-super-admin-password
SEED_DEFAULT_USER_PASSWORD=change-this-demo-user-password
ALLOW_DATABASE_RESET=false

# Shared key for IoT devices that call POST /api/v1/iot/readings.
# Generate a random value of at least 32 characters and send it as a Bearer token.
IOT_INGEST_API_KEY=replace-with-a-long-random-iot-ingest-key

# Google Drive API key for CCTV folders shared as "Anyone with the link".
# Expected folder layout per camera: <root>/<year>/<month>/<day>/<image files>
GOOGLE_DRIVE_API_KEY=replace-with-a-google-drive-api-key

# Future AI provider settings (not called during Phase 1 seed)
AI_PROVIDER=mock
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=change-me
AI_MODEL=local-model
AI_TEMPERATURE=0.2
AI_TIMEOUT_MS=30000
